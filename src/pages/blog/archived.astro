---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (
  await getCollection('blog', ({ data }) => data.archived ?? false)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`${SITE_TITLE} — Archived Posts`}
  description={SITE_DESCRIPTION}
  narrowContent
>
  <Nav />

  <main class="archived-main" id="main-content">
    <div class="archived-inner">
      <div class="archived-header">
        <h1 class="archived-h1">Archived posts</h1>
      </div>

      {
        posts.length === 0 ? (
          <p class="empty">No archived posts yet.</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="post-row">
                  {post.data.heroImage ? (
                    <Image
                      width={120}
                      height={80}
                      src={post.data.heroImage}
                      alt=""
                      class="post-thumb"
                    />
                  ) : (
                    <div class="post-thumb post-thumb--placeholder" />
                  )}
                  <div class="post-info">
                    <div class="post-date">
                      <FormattedDate date={post.data.pubDate} />
                    </div>
                    <h2 class="post-title">{post.data.title}</h2>
                  </div>
                  <span class="post-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <a href="/blog" class="back-link">← Back to Blog</a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .archived-main {
    padding: 80px 60px;
  }
  .archived-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .archived-header {
    margin-bottom: 48px;
  }
  .archived-h1 {
    font-family: var(--font-eb-garamond);
    font-weight: 400;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(22px, 2.8vw, 34px);
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
    margin: 0;
    color: var(--color-text-heading);
  }
  .empty {
    color: var(--color-green);
    font-size: 16px;
  }
  .post-list {
    display: flex;
    flex-direction: column;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
    max-width: 700px;
  }
  .post-row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }
  /* Each row is the only child of its <li>, so the last row is found by item. */
  .post-list li:last-child .post-row {
    border-bottom: 1px solid var(--color-border);
  }
  /* Same hover as the blog index: the title takes the accent color. */
  .post-row:hover .post-title {
    color: var(--color-accent);
  }
  .post-thumb {
    width: 120px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    border: 1px solid var(--color-border);
  }
  /* Holds the thumbnail column for posts without a hero image, so the text and
     arrow keep their columns. Same gradient as the blog index placeholder. */
  .post-thumb--placeholder {
    background: linear-gradient(135deg, var(--color-card) 0%, #1f3a26 100%);
  }
  .post-date {
    font-family: var(--font-dm-sans);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-heading);
    margin-bottom: 6px;
  }
  .post-title {
    margin: 0;
    font-family: var(--font-eb-garamond);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    font-size: 20px;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--color-text);
    transition: color 0.2s ease;
  }
  .post-arrow {
    color: var(--color-accent);
    font-size: 18px;
    transition: transform 0.2s;
  }
  .post-row:hover .post-arrow {
    transform: translateX(4px);
  }

  .back-link {
    display: inline-block;
    font-size: 20px;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--color-accent-bright);
  }

  @media (max-width: 900px) {
    .archived-main {
      padding: 60px 24px;
    }
    .post-row {
      grid-template-columns: 80px 1fr auto;
      gap: 16px;
    }
    .post-thumb {
      width: 80px;
      height: 56px;
    }
  }
  @media (max-width: 600px) {
    .post-row {
      grid-template-columns: 1fr auto;
    }
    .post-thumb {
      display: none;
    }
  }
</style>
