---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import WorkHistory from '../components/WorkHistory.astro';
// Imported but not rendered: the section is temporarily hidden (see below).
// Keeping the import live means knip still tracks the component and the
// workIconMap exports it depends on.
import WorkSkills from '../components/WorkSkills.astro';
import resumeData from '../data/resume.json';

const activities = resumeData.activities;
---

<BaseLayout
  title="Work — Nathan Pickard"
  description="Six years shipping consumer-facing software in fintech, wellness, and healthtech."
>
  <Nav />

  <main class="work-main">
    <div class="work-inner">
      <div class="work-header" data-reveal>
        <h1 class="work-h1">From idea to impact</h1>
        <p class="work-sub">Work that ships and results that stick</p>
      </div>

      <WorkHistory />

      {
        /* Temporarily hidden. Render <WorkSkills /> here to restore the
           "tools I reach for" section and un-skip its tests. */
        false && <WorkSkills />
      }

      <section
        class="community-section"
        aria-labelledby="community-heading"
        data-reveal
      >
        <h2 class="community-h2" id="community-heading">In the community</h2>
        <div class="community-body">
          {
            activities.map((activity) => (
              <p class="community-text">{activity}</p>
            ))
          }
        </div>
      </section>

      <div class="work-cta-row" data-reveal>
        <Button href="/resume" arrow>View full resume</Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .work-main {
    padding: 80px 60px;
  }
  .work-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .work-header {
    margin-bottom: 48px;
  }
  .work-h1 {
    font-family: var(--font-eb-garamond);
    font-weight: 400;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    margin: 0 0 12px;
    color: var(--color-text-heading);
  }
  .work-sub {
    font-size: 16px;
    color: var(--color-text-heading);
    margin: 0;
  }

  @media (max-width: 900px) {
    .work-main {
      padding: 60px 24px;
    }
  }

  /* Community section */
  .community-section {
    margin-top: 64px;
    padding-top: 64px;
    border-top: 1px solid var(--color-border);
  }
  .community-h2 {
    font-family: var(--font-eb-garamond);
    font-weight: 400;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
    color: var(--color-text-heading);
  }
  .community-text {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-heading);
    max-width: 750px;
    margin: 0 0 16px;
  }
  .community-text:last-child {
    margin-bottom: 0;
  }

  /* Resume CTA */
  .work-cta-row {
    margin-top: 64px;
    padding-top: 64px;
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 14px;
  }
</style>
