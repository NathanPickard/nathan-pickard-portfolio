---
import type { ImageMetadata, TransitionDirectionalAnimations } from 'astro';
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import FallbackImage from '../assets/blog-placeholder-2.jpg';
import dougFir from '../assets/doug-fir.jpeg';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  /** The page's text stays inside the narrow blog column, so the background
      tree can sit closer to it and still show on medium-width screens. */
  narrowContent?: boolean;
}
const {
  title,
  description = "Senior Full-Stack Engineer based in Portland, OR.",
  image = FallbackImage,
  narrowContent = false,
} = Astro.props;

// Rendered at low opacity behind a color-matrix tint, so a quality-40 WebP is
// indistinguishable from the source JPEG at a fraction of the size.
const TEXTURE_QUALITY = 40;
const siteTexture = await getImage({ src: dougFir, format: 'webp', quality: TEXTURE_QUALITY });
const { width: textureWidth, height: textureHeight } = dougFir;

const PAGE_EXIT_MS = 90;
const PAGE_ENTER_MS = 150;

const sequencedFade = {
  old: {
    name: 'pageExit',
    duration: `${PAGE_EXIT_MS}ms`,
    easing: 'cubic-bezier(0.4, 0, 1, 1)',
    fillMode: 'forwards',
  },
  new: {
    name: 'pageEnter',
    duration: `${PAGE_ENTER_MS}ms`,
    delay: `${PAGE_EXIT_MS}ms`,
    easing: 'cubic-bezier(0, 0, 0.2, 1)',
    fillMode: 'both',
  },
};

// The hand-off looks the same in both directions, so forwards and backwards
// share one definition.
const pageTransition: TransitionDirectionalAnimations = {
  forwards: sequencedFade,
  backwards: sequencedFade,
};

// Astro.site is undefined in test contexts (AstroContainer); skip absolute URLs there.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImage = Astro.site ? new URL(image.src, Astro.site) : null;
const rssURL = Astro.site ? new URL('rss.xml', Astro.site) : null;
---

<!doctype html>
<html lang="en" transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Dark UI for native scrollbars and controls; browser chrome matches --color-bg. -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0D1C10" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {rssURL && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={SITE_TITLE}
        href={rssURL}
      />
    )}

    <Font cssVariable="--font-cormorant" />
    <!-- Body and nav face on every page, so it is the one font worth preloading. -->
    <Font
      cssVariable="--font-vollkorn"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <Font cssVariable="--font-eb-garamond" />
    <Font cssVariable="--font-source-serif" />
    <Font cssVariable="--font-dm-sans" />

    <!--
      Inline on purpose. ClientRouter swaps the <head> mid-navigation and the
      browser resolves the transition immediately after; in dev, Vite's global
      component styles are injected asynchronously and are occasionally missing at
      that instant (measured: 1 navigation in 20). When that happens the keyframes
      are absent, the animation resolves to a no-op, and both pages show at once —
      the overlap this exists to prevent. Production is unaffected; this is dev
      insurance. Same reasoning for scrollbar-gutter, which read `auto` on that
      same failed navigation.
    -->
    <style is:inline>
      @keyframes pageExit {
        to {
          opacity: 0;
        }
      }
      @keyframes pageEnter {
        from {
          opacity: 0;
        }
      }
      /* Reserve the gutter so short pages (/about) that do not scroll keep the
         centered header at the same x as pages that do. */
      html {
        scrollbar-gutter: stable;
      }
    </style>

    <ClientRouter />

    {canonicalURL && socialImage && (
      <>
        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <svg
      class:list={['site-topo', { 'is-beside-narrow-content': narrowContent }]}
      aria-hidden="true"
      viewBox={`0 0 ${textureWidth} ${textureHeight}`}
      preserveAspectRatio="xMaxYMax meet"
      style={`--texture-aspect: ${textureWidth} / ${textureHeight}`}
    >
      <defs>
        <filter id="site-topo-green-tint" color-interpolation-filters="sRGB">
          <feColorMatrix
            type="matrix"
            values="0 0 0 0 0.537
                    0 0 0 0 0.682
                    0 0 0 0 0.592
                    -1 -1 -1 0 1"
          />
        </filter>
      </defs>
      <image
        href={siteTexture.src}
        width={textureWidth}
        height={textureHeight}
        preserveAspectRatio="xMidYMid slice"
        filter="url(#site-topo-green-tint)"
      />
    </svg>
    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    /* ── Type scale ── */
    --text-display: clamp(56px, 6.2vw, 96px);
    --text-h1: clamp(28px, 3.4vw, 42px);
    --text-h2: clamp(38px, 4.4vw, 60px);
    --text-h3: 22px;
    /* ── Letter-spacing ── */
    --tracking-display: -0.022em;
    --tracking-heading: -0.018em;
    --tracking-sub: -0.018em;
    --tracking-label: 0;
    /* ── Colors ── */
    --color-bg: #0D1C10;
    --color-text: #EDE8D8;
    --color-text-bright: #f7f2e4;
    --color-text-muted: #c8e0d0;
    --color-text-heading: #E2EDE6;
    --color-accent: #d4af37;
    /* Hover state for accent text and fills: lighter, so contrast goes up. */
    --color-accent-bright: #e6c55a;
    --color-border: rgba(137, 174, 151, 0.2);
    --color-card: #162b1b;
    --color-green: #8aae97;
    --color-green-light: #a8c8b4;
    /* ── Spacing ── */
    --pad-v: 80px;
    --pad-h: 60px;
    /* ── Layout ── */
    --reading-width: 850px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; }
  body {
    font-family: var(--font-vollkorn);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 100vh;
  }
  .page-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    z-index: 0;
  }
  /* The tree fills most of the viewport height and its silhouette starts just
     right of the centered reading column, so it never sits behind the text. The
     source image has blank margin on its left (--topo-blank-left, measured as a
     fraction of image width), so the box is pulled left by that much to put the
     visible branches, not the image edge, at the gap. The tree is wider than the
     gutter on most screens, so its right side runs off the viewport edge;
     fixed-position overflow does not add horizontal scroll. */
  .site-topo {
    --topo-gap: 32px;
    --topo-height: 90vh;
    --topo-blank-left: 0.17;
    --topo-opacity: 0.05;
    /* Distance from the viewport center to the right edge of the page's text. */
    --topo-content-half: calc(var(--reading-width) / 2);
    position: fixed;
    left: calc(
      50vw + var(--topo-content-half) + var(--topo-gap)
      - var(--topo-height) * var(--texture-aspect) * var(--topo-blank-left)
    );
    bottom: 0;
    height: var(--topo-height);
    aspect-ratio: var(--texture-aspect);
    pointer-events: none;
    z-index: -1;
  }
  .site-topo image {
    opacity: var(--topo-opacity);
  }
  /* Below this width the gutter shows too thin a sliver of the tree to read as
     one. 1360px ≈ --reading-width + two ~255px gutters; media queries cannot
     read custom properties. */
  @media (max-width: 1360px) {
    .site-topo {
      display: none;
    }
  }
  /* Blog text ends about 355px right of center (the blog list's rows reach
     400px), so on blog pages the tree moves in to clear the rows and keeps
     showing down to 1000px. */
  @media (min-width: 1000px) and (max-width: 1360px) {
    .site-topo.is-beside-narrow-content {
      --topo-content-half: 370px;
      display: block;
    }
  }
  .page-wrapper > main {
    flex: 1;
  }
  a { color: inherit; }
  img { max-width: 100%; height: auto; }
  /* Even line lengths in multi-line headings instead of a lone last word. */
  h1, h2, h3 { text-wrap: balance; }
  /* No double-tap-to-zoom wait on taps. */
  a, button { touch-action: manipulation; }

  /* Scroll reveal system — scoped to html.js so content is never hidden
     when the reveal script can't run (no JS, reader mode, print, crawlers). */
  @media (prefers-reduced-motion: no-preference) {
    html.js [data-reveal] {
      opacity: 0;
      transition: opacity 0.65s ease;
    }
    html.js [data-reveal].is-visible {
      opacity: 1;
    }
  }

  /* Text for screen readers only, e.g. the label after a bare count. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Off-screen until a keyboard user tabs to it, then pinned top-left. Every
     page gives its <main> id="main-content". */
  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 4px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-dm-sans);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - 24px));
  }
  .skip-link:focus {
    transform: none;
  }

  /* Keyboard focus ring */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
</style>

<script>
  function initReveal() {
    // Apply manual delays from data-reveal-delay attribute (value in ms)
    document.querySelectorAll<HTMLElement>('[data-reveal][data-reveal-delay]').forEach(el => {
      const delay = parseInt(el.getAttribute('data-reveal-delay') ?? '', 10);
      if (!isNaN(delay) && delay >= 0) el.style.transitionDelay = `${delay}ms`;
    });

    // Apply stagger delays to direct [data-reveal] children of [data-reveal-stagger] containers
    // Skip children that have an explicit data-reveal-delay so manual delays are not clobbered
    document.querySelectorAll('[data-reveal-stagger]').forEach(container => {
      const children = Array.from(container.children).filter(
        child => child.hasAttribute('data-reveal')
      ) as HTMLElement[];
      children.forEach((child, i) => {
        if (!child.hasAttribute('data-reveal-delay')) {
          child.style.transitionDelay = `${Math.min(i, 5) * 80}ms`;
        }
      });
    });

    // Observe all [data-reveal] elements that haven't already been revealed.
    // threshold: 0 + a negative bottom rootMargin means "reveal once any part
    // enters the top 90% of the viewport". A fractional threshold would strand
    // elements taller than the viewport (they can never reach that fraction).
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0, rootMargin: '0px 0px -10% 0px' }
    );

    document.querySelectorAll('[data-reveal]').forEach(el => {
      if (!el.classList.contains('is-visible')) observer.observe(el);
    });
  }

  // Fires on initial load and after each View Transition navigation
  document.addEventListener('astro:page-load', initReveal);
</script>
