---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  // Passed only for posts that opt in with `toc: true` in their frontmatter.
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, headings } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} narrowContent>
  <Nav />

  <main class="post-main" id="main-content">
    <div class="post-inner">
      <div class="post-header" data-reveal>
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-desc">{description}</p>}
        <div class="post-date">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span class="updated">
                {' '}
                · Updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </div>
        <div class="post-divider"></div>
      </div>

      {headings && <TableOfContents headings={headings} />}

      <div class="prose">
        <slot />
      </div>

      <a href="/blog" class="back-link">← Back to Blog</a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Draws the <pre class="mermaid"> blocks produced by remarkMermaid as SVG.
  // Mermaid is large, so it is only downloaded on pages that have a diagram.
  // Colors come from the site's CSS tokens so diagrams match the theme.

  // Below this width diagram labels get too small to read, so on narrow
  // screens the diagram stops shrinking and its card scrolls sideways instead.
  const MIN_READABLE_WIDTH = 560;

  function cssVar(name: string): string {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  async function renderDiagrams() {
    const nodes = [
      ...document.querySelectorAll<HTMLElement>('.prose pre.mermaid:not([data-processed])'),
    ];
    if (nodes.length === 0) return;

    try {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          darkMode: true,
          fontFamily: cssVar('--font-dm-sans'),
          background: cssVar('--color-card'),
          primaryColor: cssVar('--color-bg'),
          primaryBorderColor: cssVar('--color-green'),
          primaryTextColor: cssVar('--color-text-bright'),
          textColor: cssVar('--color-text-bright'),
          lineColor: cssVar('--color-green-light'),
        },
      });
      await mermaid.run({ nodes });

      for (const node of nodes) {
        const svg = node.querySelector('svg');
        if (!svg) continue;
        const naturalWidth = svg.viewBox.baseVal.width;
        svg.style.minWidth = `${Math.min(naturalWidth, MIN_READABLE_WIDTH)}px`;
      }
    } catch (error) {
      // The diagram source stays visible, so the post still reads sensibly.
      console.error('Mermaid diagram failed to render', error);
    }
  }

  document.addEventListener('astro:page-load', renderDiagrams);
</script>

<style>
  .post-main {
    /* Narrower than --reading-width so a line of 20px prose stays around 80
       characters, the upper end of the comfortable range for long-form reading. */
    --post-width: 820px;
    max-width: 100%;
    /* Light text on a dark background renders heavy with subpixel smoothing. */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .post-inner {
    max-width: var(--post-width);
    margin: 0 auto;
    padding: 60px 24px 80px;
  }
  .post-header {
    margin-bottom: 40px;
  }
  .post-date {
    font-family: var(--font-dm-sans);
    font-size: 14px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-bright);
    margin-top: 12px;
    margin-bottom: 16px;
  }
  .updated {
    color: #c8dccf;
  }
  .post-title {
    font-family: var(--font-eb-garamond);
    font-weight: 400;
    font-size: var(--text-h1);
    line-height: 1.05;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-bright);
    margin: 0 0 14px;
  }
  .post-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-bright);
    margin: 0 0 24px;
  }
  .post-divider {
    height: 1px;
    background: var(--color-border);
    margin-top: 8px;
  }

  /* Prose styles */
  .prose {
    font-family: var(--font-source-serif);
    /* Source Serif 4 has a smaller x-height than most text serifs, so 20px
       reads at the same size as a typical 19px body. */
    font-size: 20px;
    line-height: 1.65;
    color: var(--color-text-bright);
  }
  /* Space above a heading when a table-of-contents link jumps to it. */
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 32px;
  }
  .prose :global(h2) {
    font-family: var(--font-eb-garamond);
    font-weight: 500;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--color-text-bright);
    margin: 2em 0 0.75em;
  }
  .prose :global(h3) {
    font-family: var(--font-eb-garamond);
    font-weight: 500;
    font-size: 22px;
    color: var(--color-text-bright);
    margin: 1.75em 0 0.5em;
  }
  .prose :global(p) {
    margin: 0 0 1.4em;
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--color-accent-bright);
  }
  .prose :global(strong) {
    color: var(--color-text-bright);
    font-weight: 600;
  }
  .prose :global(code) {
    font-family: Menlo, Monaco, 'Courier New', monospace;
    font-size: 0.875em;
    background: rgba(137, 174, 151, 0.12);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 2px 6px;
    color: var(--color-text-bright);
  }
  .prose :global(pre) {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.4em;
  }
  /* Mermaid diagrams: the source shows until the script swaps in the SVG. */
  .prose :global(pre.mermaid) {
    scrollbar-width: thin;
    scrollbar-color: var(--color-green) transparent;
  }
  .prose :global(pre.mermaid[data-processed]) {
    text-align: center;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 14px;
  }
  .prose :global(blockquote) {
    border-left: 3px solid #c87840;
    padding-left: 1.25rem;
    margin: 0 0 1.4em;
    color: var(--color-text-bright);
    font-style: italic;
  }

  /* GitHub-style alerts (`> [!NOTE]` etc.), rendered by
     remark-github-blockquote-alert. Each type sets --alert-color. */
  .prose :global(.markdown-alert) {
    --alert-color: var(--color-accent);
    margin: 0 0 1.4em;
    padding: 16px 20px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--alert-color);
    border-radius: 0 8px 8px 0;
  }
  .prose :global(.markdown-alert-tip) {
    --alert-color: var(--color-green-light);
  }
  .prose :global(.markdown-alert-important) {
    --alert-color: #bba6d9;
  }
  .prose :global(.markdown-alert-warning) {
    --alert-color: var(--color-accent);
  }
  .prose :global(.markdown-alert-caution) {
    --alert-color: #e08a74;
  }
  .prose :global(.markdown-alert-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-family: var(--font-dm-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--alert-color);
  }
  .prose :global(.markdown-alert-title svg) {
    flex: none;
    fill: currentColor;
  }
  .prose :global(.markdown-alert > :last-child) {
    margin-bottom: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2em 0;
  }
  .prose :global(img) {
    /* border-radius: 8px;
    border: 1px solid var(--color-border); */
    margin: 1em 0;
  }

  .prose :global(.post-float-right),
  .prose :global(.post-float-left) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 320px;
  }
  .prose :global(.post-float-right.is-small),
  .prose :global(.post-float-left.is-small) {
    max-width: 200px;
  }
  .prose :global(.post-float-right.is-large),
  .prose :global(.post-float-left.is-large) {
    max-width: 440px;
  }
  .prose :global(.post-float-right) {
    float: right;
    margin: 0.25rem 0 1rem 1.5rem;
  }
  .prose :global(.post-float-left) {
    float: left;
    margin: 0.25rem 1.5rem 1rem 0;
  }
  .prose :global(.post-float-right img),
  .prose :global(.post-float-left img) {
    width: 100%;
    height: auto;
    margin: 0;
  }

  .prose :global(.post-image) {
    margin: 1.6em auto;
    max-width: 560px;
  }
  .prose :global(.post-image.is-small) {
    max-width: 320px;
  }
  .prose :global(.post-image.is-large) {
    max-width: 100%;
  }
  .prose :global(.post-image.is-full) {
    max-width: min(960px, calc(100vw - 48px));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .prose :global(.post-image img) {
    width: 100%;
    height: auto;
    margin: 0;
    display: block;
  }

  @media (max-width: 720px) {
    .prose :global(.post-float-right),
    .prose :global(.post-float-left) {
      float: none;
      max-width: 100%;
      margin: 1.4em 0;
    }
    .prose :global(.post-image),
    .prose :global(.post-image.is-small),
    .prose :global(.post-image.is-full) {
      max-width: 100%;
      margin-left: auto;
      transform: none;
    }
  }

  .prose :global(figure) {
    margin: 2em 0;
  }
  .prose :global(figure img) {
    margin: 0;
    display: block;
  }
  .prose :global(figcaption) {
    font-family: var(--font-eb-garamond);
    font-style: italic;
    font-size: 1em;
    color: var(--color-text-bright);
    text-align: left;
    margin-top: 0.75em;
  }

  .back-link {
    display: inline-block;
    margin-top: 48px;
    font-size: 20px;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--color-accent-bright);
  }

  @media (max-width: 720px) {
    .post-inner {
      padding: 40px 20px 60px;
    }
  }
</style>
