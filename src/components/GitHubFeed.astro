---
import { Icon } from 'astro-icon/components';

const GITHUB_USER = 'nathanpickard';
const REPO_COUNT = 5;
---

<section
  class="github-feed"
  data-github-user={GITHUB_USER}
  data-repo-count={REPO_COUNT}
>
  <h3 class="feed-heading">
    <Icon name="devicon:github" size={24} aria-hidden="true" />
    Recent GitHub activity
  </h3>

  <p class="feed-status" role="status" data-feed-status>Loading repositories…</p>
  <ul class="repo-grid" data-feed-list hidden></ul>

  <a
    class="view-all"
    href={`https://github.com/${GITHUB_USER}`}
    target="_blank"
    rel="noopener noreferrer"
  >
    View all on GitHub →</a
  >

  <!-- Rendered at build time so it carries Astro's scoped-style attribute;
       cloned per repo in the script below (same pattern as BlueskyFeed). -->
  <template class="repo-template">
    <li class="repo-card">
      <a target="_blank" rel="noopener noreferrer" class="repo-link">
        <p class="repo-name"></p>
        <p class="repo-description" hidden></p>
        <div class="repo-meta">
          <span class="repo-lang" hidden>
            <span class="lang-dot" aria-hidden="true"></span>
            <span class="lang-name"></span>
          </span>
          <span class="repo-stats">
            <span title="Stars" class="repo-stars" hidden>
              <Icon name="mdi:star-outline" size={13} aria-hidden="true" />
              <span class="star-count"></span>
              <span class="visually-hidden">stars</span>
            </span>
            <time></time>
          </span>
        </div>
      </a>
    </li>
  </template>
</section>

<script>
  import {
    formatShortDate,
    registerFeed,
    showFeedList,
  } from '../utils/clientFeed';

  // Client-side GitHub feed via the public, unauthenticated REST API (no token in
  // the browser). One request per load; 60/hr per visitor IP — fine for a
  // portfolio. The shared lifecycle in clientFeed.ts handles caching and status
  // messages. Cards are cloned from the build-time <template> so scoped styles
  // apply (createElement nodes would miss Astro's data-astro-cid attribute).

  // REST's `language` is a name only, so map Linguist colors; gray fallback.
  const LANG_COLORS: Record<string, string> = {
    JavaScript: '#f1e05a',
    TypeScript: '#3178c6',
    HTML: '#e34c26',
    CSS: '#563d7c',
    SCSS: '#c6538c',
    Less: '#1d365d',
    Python: '#3572A5',
    Astro: '#ff5a03',
    Vue: '#41b883',
    Svelte: '#ff3e00',
    Shell: '#89e051',
    Dockerfile: '#384d54',
    Java: '#b07219',
    Kotlin: '#A97BFF',
    Go: '#00ADD8',
    Rust: '#dea584',
    Ruby: '#701516',
    PHP: '#4F5D95',
    'C#': '#178600',
    'C++': '#f34b7d',
    C: '#555555',
    Swift: '#F05138',
    MDX: '#fcb32c',
    'Jupyter Notebook': '#DA5B0B',
    Makefile: '#427819',
  };
  const LANG_COLOR_FALLBACK = '#8b8b8b';
  const DEFAULT_REPO_COUNT = 5;

  type Repo = {
    name: string;
    description: string | null;
    html_url: string;
    language: string | null;
    stargazers_count: number;
    pushed_at: string;
    fork: boolean;
    archived: boolean;
  };

  function renderRepo(
    template: HTMLTemplateElement,
    repo: Repo,
  ): HTMLLIElement {
    const node = template.content.firstElementChild!.cloneNode(
      true,
    ) as HTMLLIElement;

    (node.querySelector('.repo-link') as HTMLAnchorElement).href =
      repo.html_url;
    (node.querySelector('.repo-name') as HTMLElement).textContent = repo.name;

    const desc = node.querySelector('.repo-description') as HTMLElement;
    if (repo.description) {
      desc.textContent = repo.description;
      desc.hidden = false;
    }

    if (repo.language) {
      const dot = node.querySelector('.lang-dot') as HTMLElement;
      dot.style.backgroundColor =
        LANG_COLORS[repo.language] ?? LANG_COLOR_FALLBACK;
      (node.querySelector('.lang-name') as HTMLElement).textContent =
        repo.language;
      (node.querySelector('.repo-lang') as HTMLElement).hidden = false;
    }

    if (repo.stargazers_count > 0) {
      (node.querySelector('.star-count') as HTMLElement).textContent = String(
        repo.stargazers_count,
      );
      (node.querySelector('.repo-stars') as HTMLElement).hidden = false;
    }

    const time = node.querySelector('time') as HTMLTimeElement;
    time.dateTime = repo.pushed_at;
    time.textContent = formatShortDate(repo.pushed_at);

    return node;
  }

  async function fetchRepos(section: HTMLElement): Promise<Repo[]> {
    const user = section.dataset.githubUser ?? '';
    const count = parseInt(
      section.dataset.repoCount ?? String(DEFAULT_REPO_COUNT),
      10,
    );

    const res = await fetch(
      `https://api.github.com/users/${user}/repos?sort=pushed&direction=desc&type=owner&per_page=100`,
      { headers: { Accept: 'application/vnd.github+json' } },
    );
    if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);

    const all = (await res.json()) as Repo[];
    return all.filter((r) => !r.fork && !r.archived).slice(0, count);
  }

  function paintRepos(section: HTMLElement, repos: Repo[]) {
    const grid = section.querySelector('.repo-grid') as HTMLUListElement;
    const template = section.querySelector(
      '.repo-template',
    ) as HTMLTemplateElement;
    grid.replaceChildren(...repos.map((repo) => renderRepo(template, repo)));
    showFeedList(section);
  }

  registerFeed<Repo[]>({
    selector: '.github-feed',
    name: 'GitHubFeed',
    cacheKey: (section) => `gh-feed:${section.dataset.githubUser}`,
    fetchFirstPage: fetchRepos,
    isEmpty: (repos) => repos.length === 0,
    paint: paintRepos,
    emptyMessage: 'No repositories found.',
    errorMessage: 'Could not load repositories right now.',
  });
</script>

<style>
  .github-feed {
    min-width: 0;
    flex: 1;
  }

  .feed-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Explicit so the spacing doesn't depend on the heading level's UA default. */
    margin-top: 1.33em;
    margin-bottom: 1.25rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .feed-status {
    color: var(--color-text-muted);
    font-size: 0.9em;
  }

  .repo-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .repo-card {
    border: 1px solid #e8e6e0;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 4px rgba(42, 125, 79, 0.06);
    transition:
      box-shadow 0.15s ease,
      transform 0.1s ease;
  }

  .repo-card:hover {
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.1);
    transform: translateY(-1px);
  }

  .repo-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
    box-sizing: border-box;
  }

  .repo-name {
    margin: 0;
    font-size: 1.1em;
    font-weight: 600;
    color: var(--color-accent);
    /* Repo names have no spaces to break on. */
    overflow-wrap: anywhere;
  }

  .repo-description {
    margin: 0;
    font-size: 0.95em;
    color: var(--color-text-heading);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .repo-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8em;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .repo-meta time {
    font-family: var(--font-ui);
    font-size: 1.1em;
  }

  .repo-lang {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lang-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .repo-stats {
    display: flex;
    gap: 0.75rem;
  }

  .repo-stars {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .view-all {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 1rem;
  }
</style>
