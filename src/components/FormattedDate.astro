---
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString('en-us', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      // Frontmatter dates (`2018-09-02`) parse as UTC midnight. Formatting in
      // the build machine's zone would show the day before anywhere west of UTC.
      timeZone: 'UTC',
    })
  }
</time>
