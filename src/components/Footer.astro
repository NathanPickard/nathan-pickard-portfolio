---
import { Icon } from 'astro-icon/components';
import SocialLinks from './SocialLinks.astro';
import { EMAIL_LINK, SOCIAL_PROFILES } from '../data/socials';

const year = new Date().getFullYear();
const socials = [...SOCIAL_PROFILES, EMAIL_LINK];
---

<footer class="dark-footer">
  <div class="dark-footer-grid">
    <div>
      <div class="dark-footer-name">Nathan Pickard</div>
      <div class="dark-footer-sub">
        Software Engineer · Portland, OR
        <Icon
          name="mdi:pine-tree-variant-outline"
          size={18}
          class="location-icon"
          aria-hidden="true"
        />
      </div>
    </div>
    <SocialLinks socials={socials} class="dark-footer-links" />
    <div class="dark-footer-copy">© {year}</div>
  </div>
</footer>

<style>
  .dark-footer {
    background: var(--color-card);
    border-top: 1px solid var(--color-border);
    padding: 48px 60px;
    margin-top: 80px;
  }
  .dark-footer-grid {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
  }
  .dark-footer-name {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .dark-footer-sub {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    margin-top: 6px;
  }
  .dark-footer-sub :global(.location-icon) {
    display: inline-block;
    vertical-align: -4px;
    margin-left: 4px;
    color: var(--color-green);
  }
  .dark-footer-links {
    justify-content: center;
  }
  .dark-footer-copy {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    text-align: right;
  }

  @media (max-width: 900px) {
    .dark-footer {
      padding: 32px 24px;
      margin-top: 48px;
    }
    .dark-footer-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .dark-footer-copy {
      text-align: left;
    }
    .dark-footer-links {
      justify-content: flex-start;
    }
  }
</style>
