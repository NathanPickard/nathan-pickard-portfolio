---
import { Icon } from "astro-icon/components";
const BLUESKY_HANDLE = "nathanpickard.bsky.social";
const FEED_LIMIT = 10;
---

<section
  class="bluesky-feed"
  data-bluesky-handle={BLUESKY_HANDLE}
  data-feed-limit={FEED_LIMIT}
>
  <h4 class="feed-heading">
    <Icon name="bluesky" size={24} aria-hidden="true" />
    Bluesky
  </h4>

  <p class="feed-error" data-feed-status>Loading posts…</p>

  <div class="feed-scroll">
    <ul class="posts" hidden></ul>

    <div class="feed-sentinel" aria-hidden="true"></div>
    <p class="feed-loading" hidden>Loading...</p>
    <p class="feed-end" hidden>You're all caught up.</p>
  </div>

  <a
    class="view-all"
    href={`https://bsky.app/profile/${BLUESKY_HANDLE}`}
    target="_blank"
    rel="noopener noreferrer"
  >
    View all on Bluesky →
  </a>

  <!-- Rendered at build time so it carries Astro's scoped-style attribute;
       cloned per post in the script below (same pattern as GitHubFeed). -->
  <template class="post-template">
    <li class="post">
      <a target="_blank" rel="noopener noreferrer" class="post-link">
        <p class="post-date"><time></time></p>
        <p class="post-text"></p>
        <div class="post-images" hidden></div>
        <div class="post-external-thumb" hidden>
          <img class="post-img" loading="lazy" alt="" />
        </div>
        <div class="post-meta">
          <span class="post-stats">
            <span title="Replies" class="stat stat-reply">
              <Icon name="mdi:message-outline" size={18} aria-hidden="true" />
              <span class="stat-count"></span>
            </span>
            <span title="Reposts" class="stat stat-repost">
              <Icon name="mdi:repeat" size={18} aria-hidden="true" />
              <span class="stat-count"></span>
            </span>
            <span title="Likes" class="stat stat-like">
              <Icon name="mdi:heart-outline" size={18} aria-hidden="true" />
              <span class="stat-count"></span>
            </span>
          </span>
        </div>
      </a>
    </li>
  </template>

  <template class="post-image-template">
    <img class="post-img" loading="lazy" alt="" />
  </template>
</section>

<script>
  import { readFeedCache, writeFeedCache } from "../utils/feedCache";

  // Client-side Bluesky feed via the public, unauthenticated AppView API (same
  // pattern as GitHubFeed): one request per load, session-cached, so the feed
  // never goes stale between Netlify builds. Posts are cloned from the
  // build-time <template>s so Astro's scoped styles apply.

  type EmbedImage = { thumb: string; alt: string };
  type Embed = {
    $type: string;
    images?: EmbedImage[];
    external?: { uri: string; title: string; thumb?: string };
  };
  type FeedItem = {
    post: {
      uri: string;
      record: { text: string; createdAt: string };
      embed?: Embed;
      replyCount?: number;
      repostCount?: number;
      likeCount?: number;
    };
    reason?: { $type: string };
  };
  type FeedPage = { feed: FeedItem[]; cursor: string };

  type FeedElements = {
    section: HTMLElement;
    status: HTMLElement | null;
    scroll: HTMLElement;
    list: HTMLUListElement;
    sentinel: HTMLElement;
    loading: HTMLElement;
    end: HTMLElement;
    postTemplate: HTMLTemplateElement;
    imageTemplate: HTMLTemplateElement;
    handle: string;
    limit: string;
  };

  const API_URL =
    "https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed";
  const MAX_IMAGES = 4;
  const SCROLL_ROOT_MARGIN = "200px";

  function getElements(section: HTMLElement): FeedElements | null {
    const q = <T extends Element>(sel: string) =>
      section.querySelector<T>(sel);
    const scroll = q<HTMLElement>(".feed-scroll");
    const list = q<HTMLUListElement>(".posts");
    const sentinel = q<HTMLElement>(".feed-sentinel");
    const loading = q<HTMLElement>(".feed-loading");
    const end = q<HTMLElement>(".feed-end");
    const postTemplate = q<HTMLTemplateElement>(".post-template");
    const imageTemplate = q<HTMLTemplateElement>(".post-image-template");
    const handle = section.dataset.blueskyHandle;
    const limit = section.dataset.feedLimit;

    if (
      !scroll || !list || !sentinel || !loading || !end ||
      !postTemplate || !imageTemplate || !handle || !limit
    ) {
      return null;
    }

    return {
      section,
      status: q<HTMLElement>("[data-feed-status]"),
      scroll,
      list,
      sentinel,
      loading,
      end,
      postTemplate,
      imageTemplate,
      handle,
      limit,
    };
  }

  function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  }

  function postUrl(handle: string, uri: string) {
    const rkey = uri.split("/").pop();
    return `https://bsky.app/profile/${handle}/post/${rkey}`;
  }

  function renderEmbed(els: FeedElements, node: HTMLElement, embed?: Embed) {
    const images =
      embed?.$type === "app.bsky.embed.images#view" ? (embed.images ?? []) : [];
    const externalThumb =
      embed?.$type === "app.bsky.embed.external#view" && embed.external?.thumb
        ? embed.external.thumb
        : null;

    if (images.length > 0) {
      const grid = node.querySelector(".post-images") as HTMLDivElement;
      grid.hidden = false;
      grid.classList.add(`count-${Math.min(images.length, MAX_IMAGES)}`);
      images.slice(0, MAX_IMAGES).forEach((img) => {
        const imgEl = els.imageTemplate.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLImageElement;
        imgEl.src = img.thumb;
        imgEl.alt = img.alt;
        grid.appendChild(imgEl);
      });
    } else if (externalThumb) {
      const ext = node.querySelector(".post-external-thumb") as HTMLDivElement;
      ext.hidden = false;
      const img = ext.querySelector("img") as HTMLImageElement;
      img.src = externalThumb;
      img.alt = embed?.external?.title ?? "";
    }
  }

  function renderPost(els: FeedElements, item: FeedItem): HTMLLIElement {
    const node = els.postTemplate.content.firstElementChild!.cloneNode(
      true,
    ) as HTMLLIElement;

    const link = node.querySelector(".post-link") as HTMLAnchorElement;
    link.href = postUrl(els.handle, item.post.uri);

    const time = node.querySelector(".post-date time") as HTMLTimeElement;
    time.dateTime = item.post.record.createdAt;
    time.textContent = formatDate(item.post.record.createdAt);

    (node.querySelector(".post-text") as HTMLElement).textContent =
      item.post.record.text;

    renderEmbed(els, node, item.post.embed);

    const setStat = (selector: string, count: number | undefined) => {
      const el = node.querySelector(selector) as HTMLSpanElement;
      if (count != null) {
        (el.querySelector(".stat-count") as HTMLElement).textContent =
          String(count);
      } else {
        el.hidden = true;
      }
    };
    setStat(".stat-reply", item.post.replyCount);
    setStat(".stat-repost", item.post.repostCount);
    setStat(".stat-like", item.post.likeCount);

    return node;
  }

  async function fetchPage(
    handle: string,
    limit: string,
    cursor = "",
  ): Promise<FeedPage> {
    const params = new URLSearchParams({
      actor: handle,
      limit,
      filter: "posts_no_replies",
    });
    if (cursor) params.set("cursor", cursor);

    const res = await fetch(`${API_URL}?${params}`);
    if (!res.ok) throw new Error(`Bluesky API responded ${res.status}`);

    const data = (await res.json()) as { feed?: FeedItem[]; cursor?: string };
    return {
      // Exclude reposts.
      feed: (data.feed ?? []).filter((item) => !item.reason),
      cursor: data.cursor ?? "",
    };
  }

  function showStatus(els: FeedElements, message: string) {
    els.list.hidden = true;
    if (els.status) {
      els.status.hidden = false;
      els.status.textContent = message;
    }
  }

  function startInfiniteScroll(els: FeedElements, initialCursor: string) {
    if (!initialCursor) {
      els.end.hidden = false;
      return;
    }

    let cursor = initialCursor;
    let loading = false;

    const loadMore = async () => {
      if (loading || !cursor) return;
      loading = true;
      els.loading.hidden = false;

      try {
        const page = await fetchPage(els.handle, els.limit, cursor);
        page.feed.forEach((item) =>
          els.list.appendChild(renderPost(els, item)),
        );
        cursor = page.cursor;
        if (!cursor) {
          els.end.hidden = false;
          observer.disconnect();
        }
      } catch {
        // Silently fail — posts already shown remain visible.
      } finally {
        loading = false;
        els.loading.hidden = true;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) loadMore();
      },
      { root: els.scroll, rootMargin: SCROLL_ROOT_MARGIN },
    );
    observer.observe(els.sentinel);
  }

  function paintFirstPage(els: FeedElements, page: FeedPage) {
    els.list.replaceChildren(
      ...page.feed.map((item) => renderPost(els, item)),
    );
    els.list.hidden = false;
    if (els.status) els.status.hidden = true;
    startInfiniteScroll(els, page.cursor);
  }

  async function loadFeed(section: HTMLElement) {
    if (
      section.dataset.feedState === "loading" ||
      section.dataset.feedState === "loaded"
    ) {
      return;
    }
    const els = getElements(section);
    if (!els) return;

    section.dataset.feedState = "loading";
    const cacheKey = `bsky-feed:${els.handle}`;

    // Session cache so revisits (incl. View Transition navigations) are instant.
    const cached = readFeedCache<FeedPage>(cacheKey);
    if (cached) {
      paintFirstPage(els, cached);
      section.dataset.feedState = "loaded";
      return;
    }

    try {
      const page = await fetchPage(els.handle, els.limit);
      if (page.feed.length === 0) {
        showStatus(els, "No posts found.");
        section.dataset.feedState = "loaded";
        return;
      }
      writeFeedCache(cacheKey, page);
      paintFirstPage(els, page);
      section.dataset.feedState = "loaded";
    } catch (err) {
      console.warn("BlueskyFeed: fetch failed", err);
      showStatus(els, "Could not load posts right now.");
      section.dataset.feedState = "";
    }
  }

  function initFeeds() {
    document
      .querySelectorAll<HTMLElement>(".bluesky-feed")
      .forEach((section) => loadFeed(section));
  }

  // Homepage uses View Transitions — astro:page-load fires on first load and on
  // every client-side navigation back to this page.
  document.addEventListener("astro:page-load", initFeeds);
</script>

<style>
  .bluesky-feed {
    min-width: 0;
    flex: 1;
  }

  .feed-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
  }

  .feed-error {
    color: #c8e0d0;
    font-size: 0.9em;
  }

  .feed-loading,
  .feed-end {
    font-size: 0.85em;
    color: #c8e0d0;
    text-align: center;
    margin: 1rem 0 0;
  }

  .feed-scroll {
    height: 640px;
    overflow-y: auto;
    padding: 0.25rem 0.75rem 0.25rem 0.25rem;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: rgba(137, 174, 151, 0.3) transparent;
  }

  :global(.posts) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
  }

  :global(.post) {
    width: 100%;
    border: 1px solid #e8e6e0;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 4px rgba(42, 125, 79, 0.06);
    transition:
      box-shadow 0.15s ease,
      transform 0.1s ease;
  }

  :global(.post:hover) {
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.1);
    transform: translateY(-1px);
  }

  :global(.post-link) {
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  :global(.post-text) {
    margin: 0 0 0.5rem 0;
    font-size: 1.05em;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  :global(.post-images) {
    display: grid;
    gap: 4px;
    margin: 0.5rem 0;
    border-radius: 6px;
    overflow: hidden;
  }

  :global(.post-images.count-1) {
    grid-template-columns: 1fr;
  }

  :global(.post-images.count-2) {
    grid-template-columns: 1fr 1fr;
  }

  :global(.post-images.count-3) {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
  }

  :global(.post-images.count-3 .post-img:first-child) {
    grid-column: 1 / -1;
  }

  :global(.post-images.count-4) {
    grid-template-columns: 1fr 1fr;
  }

  :global(.post-img) {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 0;
    display: block;
    margin: 0;
  }

  :global(.post-images.count-1 .post-img) {
    max-height: 400px;
    height: auto;
  }

  :global(.post-external-thumb) {
    margin: 0.5rem 0;
    border-radius: 6px;
    overflow: hidden;
  }

  :global(.post-external-thumb .post-img) {
    height: 180px;
  }

  :global(.post-meta) {
    display: flex;
    align-items: center;
    font-size: 0.8em;
    color: #c8e0d0;
  }

  :global(.post-date) {
    margin: 0 0 0.4rem 0;
    font-size: 1em;
    color: #c8e0d0;
  }

  :global(.post-stats) {
    display: flex;
    gap: 0.75rem;
    font-size: 1rem;
  }

  :global(.stat) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  :global(.stat-icon) {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  :global(.stat-reply) {
    color: #8aae97;
  }
  :global(.stat-repost) {
    color: #8aae97;
  }
  :global(.stat-like) {
    color: #8aae97;
  }

  .view-all {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .feed-scroll {
      height: 400px;
    }
  }
</style>
